<div class="px-4 sm:px-6 lg:px-8">
  <%= turbo_stream_from "recipe_change" %>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="table-fixed min-w-full divide-y divide-gray-300">
          <thead>
          <tr class="divide-x divide-gray-200">
            <% week_days(entries).each do |date| %>
              <th scope="col" class="text-center text-sm">
                <div class="font-semibold text-gray-900"><%= date.strftime("%A") %></div>
                <div class="font-semibold text-gray-500"><%= date %></div>
              </th>
            <% end %>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <%= render "entries/entry_cell", entries: get_lunches(entries) %>
            <%= render "entries/entry_cell", entries: get_dinners(entries) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>